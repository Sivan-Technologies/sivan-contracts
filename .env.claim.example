# Merge into your ignored .env.testnet, or inject into a protected test runtime.
# Never use production private keys. No RPC URL or token address is implied.
EVM_PROFILE=testnet
CELO_SEPOLIA_RPC_URL=
CELO_SEPOLIA_CLAIM_VERSION=v1
CELO_SEPOLIA_CLAIM_DEPLOYER_ADDRESS=
CELO_SEPOLIA_CLAIM_DEPLOYER_PRIVATE_KEY=
CELO_SEPOLIA_CLAIM_ADMIN=
CELO_SEPOLIA_CLAIM_TREASURY=
# Explicit test EOAs only; production remains blocked in every mode.
CELO_SEPOLIA_CLAIM_CONTROL_MODE=testnet_eoa
CELO_SEPOLIA_CLAIM_RISK_ACK=bearer-key-seven-day-net-refund-nonrefundable-fee
# JSON array: {"address":"0x...","symbol":"USDC","decimals":6,"codeHash":"0x...32 bytes..."}
# codeHash = keccak256 of reviewed eth_getCode output; proxies need separate implementation review.
CELO_SEPOLIA_CLAIM_TOKENS_JSON=
CLAIM_DEPLOY_CONFIRM=
# Source verification; configure for the selected explorer.
CELO_SEPOLIA_EXPLORER_API_URL=
CELO_SEPOLIA_EXPLORER_BROWSER_URL=
CELO_SEPOLIA_EXPLORER_API_KEY=
# When CONTROL_MODE=multisig, both roles require these reviewed 2-of-3 policies.
CELO_SEPOLIA_CLAIM_ADMIN_OWNERS_JSON=
CELO_SEPOLIA_CLAIM_ADMIN_CODE_HASH=
CELO_SEPOLIA_CLAIM_ADMIN_IMPLEMENTATION_CODE_HASH=
CELO_SEPOLIA_CLAIM_ADMIN_FALLBACK_CODE_HASH=
CELO_SEPOLIA_CLAIM_TREASURY_OWNERS_JSON=
CELO_SEPOLIA_CLAIM_TREASURY_CODE_HASH=
CELO_SEPOLIA_CLAIM_TREASURY_IMPLEMENTATION_CODE_HASH=
CELO_SEPOLIA_CLAIM_TREASURY_FALLBACK_CODE_HASH=
