EVM_PROFILE=testnet
# Example only. Copy needed fields into .env; preserve existing private settings.
# Public testnet defaults only; no private keys. Dedicated test wallets only.
# Public token metadata JSON: [{"address":"<verified address>","symbol":"USDC","decimals":6}]
# Verify token addresses against the issuer's official list before use.
# Keep confirmation blank except during a separately authorized deployment.
# Public defaults verified against official network/Circle documentation, 2026-09-26.
# Public RPCs are best-effort test infrastructure; use a dedicated provider for reliable operations.
# FEE_COLLECTOR: receiving wallet address only, not a private key.
# Testnet: dedicated test wallet. Production recommendation: reviewed 2-of-3 multisig per chain.
# AGENT_ATTESTER: separate ECDSA account; do not use the treasury multisig here.
# Leave deployment confirmation blank. These settings do not authorize a deployment.
EVM_DEPLOY_CONFIRM=

# CELO_SEPOLIA: controlled testnet candidate, not production certified.
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Informational; deployment checks the chain ID in config/evm-networks.cjs.
CELO_SEPOLIA_CHAIN_ID=11142220
CELO_SEPOLIA_DEPLOYER_ADDRESS=
CELO_SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Treasury and administration (separate from deployer and automated attester).
CELO_SEPOLIA_CONTROL_MODE=testnet_eoa
CELO_SEPOLIA_ADMIN_ADDRESS=
# For multisig mode, use verified 2-of-3 deployed Safes and reviewed bytecode hashes.
CELO_SEPOLIA_TREASURY_OWNERS_JSON=
CELO_SEPOLIA_TREASURY_CODE_HASH=
CELO_SEPOLIA_TREASURY_IMPLEMENTATION_CODE_HASH=
# Zero hash means no handler; otherwise pin the reviewed handler code hash.
CELO_SEPOLIA_TREASURY_FALLBACK_CODE_HASH=
CELO_SEPOLIA_ADMIN_OWNERS_JSON=
CELO_SEPOLIA_ADMIN_CODE_HASH=
CELO_SEPOLIA_ADMIN_IMPLEMENTATION_CODE_HASH=
# Zero hash means no handler; otherwise pin the reviewed handler code hash.
CELO_SEPOLIA_ADMIN_FALLBACK_CODE_HASH=
CELO_SEPOLIA_FEE_COLLECTOR=
CELO_SEPOLIA_AGENT_ATTESTER=
CELO_SEPOLIA_AGENT_ID=
CELO_SEPOLIA_ATTESTER_PROOF_EXPIRY=
CELO_SEPOLIA_ATTESTER_PROOF_SIGNATURE=
CELO_SEPOLIA_CONTRACT_VERSION=v2
CELO_SEPOLIA_TOKENS_JSON=[{"address":"0x01C5C0122039549AD1493B8220cABEdD739BC44E","symbol":"USDC","decimals":6}]
CELO_SEPOLIA_EXPLORER_API_URL=
CELO_SEPOLIA_EXPLORER_BROWSER_URL=https://celo-sepolia.blockscout.com
CELO_SEPOLIA_EXPLORER_API_KEY=

