# Merge selected fields into .env.testnet; this file is not automatically loaded.
# No deployment authorized by this template. Mainnet/production remain blocked.
MILESTONE_DEPLOY_CONFIRM=
# Uses CELO_SEPOLIA_RPC_URL from the existing network profile; no embedded RPC.
CELO_SEPOLIA_MILESTONE_DEPLOYER_ADDRESS=
CELO_SEPOLIA_MILESTONE_DEPLOYER_PRIVATE_KEY=
# Optional override; otherwise CELO_SEPOLIA_FEE_COLLECTOR then SIVAN_FEE_COLLECTOR.
CELO_SEPOLIA_MILESTONE_FEE_COLLECTOR=
CELO_SEPOLIA_MILESTONE_PRIMARY_REVIEWER=
CELO_SEPOLIA_MILESTONE_FEE_BPS=
CELO_SEPOLIA_MILESTONE_VERSION=v1
# Explicit acknowledgement value: immutable-no-pause-no-role-rotation
CELO_SEPOLIA_MILESTONE_RISK_ACK=
CELO_SEPOLIA_MILESTONE_CONTROL_MODE=testnet_eoa
# Reviewed [{"address":"...","symbol":"USDC","decimals":6}]; no assumed tokens.
CELO_SEPOLIA_MILESTONE_TOKENS_JSON=
CELO_SEPOLIA_MILESTONE_REVIEWER_PROOF_EXPIRY=
CELO_SEPOLIA_MILESTONE_REVIEWER_PROOF_SIGNATURE=
# Required only in multisig mode: verified 2-of-3 policies for both wallets.
CELO_SEPOLIA_MILESTONE_TREASURY_OWNERS_JSON=
CELO_SEPOLIA_MILESTONE_TREASURY_CODE_HASH=
CELO_SEPOLIA_MILESTONE_TREASURY_IMPLEMENTATION_CODE_HASH=
CELO_SEPOLIA_MILESTONE_TREASURY_FALLBACK_CODE_HASH=
CELO_SEPOLIA_MILESTONE_REVIEWER_OWNERS_JSON=
CELO_SEPOLIA_MILESTONE_REVIEWER_CODE_HASH=
CELO_SEPOLIA_MILESTONE_REVIEWER_IMPLEMENTATION_CODE_HASH=
CELO_SEPOLIA_MILESTONE_REVIEWER_FALLBACK_CODE_HASH=
# Base/Arbitrum testnets use identical suffixes with BASE_SEPOLIA/ARBITRUM_SEPOLIA.
