# PUBLIC CONFIGURATION ONLY. This profile cannot deploy production.
# Select it explicitly: EVM_PROFILE=production <command>
# Never put private keys, seed phrases, API credentials or private RPC URLs here.
# Inject endpoints/credentials using the deployment platform's protected runtime.
# Hardware/KMS signing adapter and independent approval remain release blockers.
EVM_PROFILE=production
EVM_DEPLOY_CONFIRM=
# Shared fee recipient for this profile only; keep testnet and production separate.
# Optional <NETWORK>_FEE_COLLECTOR overrides this. Blank overrides use this default.
# Multisigs must be deployed and pass policy checks on EACH receiving chain.
SIVAN_FEE_COLLECTOR=

# Celo production reference. Mainnet execution stays blocked in code.
CELO_CONTROL_MODE=multisig
CELO_DEPLOYER_ADDRESS=
CELO_ADMIN_ADDRESS=
CELO_FEE_COLLECTOR=
CELO_AGENT_ATTESTER=
CELO_AGENT_ID=
CELO_CONTRACT_VERSION=v2
CELO_TOKENS_JSON=

# Treasury: exactly three reviewed signers; expected on-chain threshold is two.
CELO_TREASURY_OWNERS_JSON=
CELO_TREASURY_CODE_HASH=
CELO_TREASURY_IMPLEMENTATION_CODE_HASH=
# Zero hash means no handler; otherwise pin the reviewed handler code hash.
CELO_TREASURY_FALLBACK_CODE_HASH=

# Separate administration Safe; not the treasury or the automated signer.
CELO_ADMIN_OWNERS_JSON=
CELO_ADMIN_CODE_HASH=
CELO_ADMIN_IMPLEMENTATION_CODE_HASH=
# Zero hash means no handler; otherwise pin the reviewed handler code hash.
CELO_ADMIN_FALLBACK_CODE_HASH=

# Public verification endpoints only; API credentials come from secret management.
CELO_EXPLORER_BROWSER_URL=
CELO_EXPLORER_API_URL=
