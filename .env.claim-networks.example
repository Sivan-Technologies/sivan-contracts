# Additional Claim Vault network profiles
# Merge only the selected profile into ignored .env.testnet. All values are intentionally blank.
# EVM_PROFILE=testnet; no mainnet deployment is enabled.
# All claim roles, tokens and keys remain separate per chain.
# For multisig policies and risk semantics see .env.claim.example.

# BASE_SEPOLIA: candidate; pending profiles remain deployment-blocked.
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_CLAIM_VERSION=v1
BASE_SEPOLIA_CLAIM_DEPLOYER_ADDRESS=
BASE_SEPOLIA_CLAIM_DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_CLAIM_ADMIN=
BASE_SEPOLIA_CLAIM_TREASURY=
BASE_SEPOLIA_CLAIM_CONTROL_MODE=testnet_eoa
BASE_SEPOLIA_CLAIM_RISK_ACK=bearer-key-seven-day-net-refund-nonrefundable-fee
BASE_SEPOLIA_CLAIM_TOKENS_JSON=
BASE_SEPOLIA_EXPLORER_API_URL=
BASE_SEPOLIA_EXPLORER_BROWSER_URL=
BASE_SEPOLIA_EXPLORER_API_KEY=

